{
  "keywords": [
    {
      "pattern": "^.*ERROR.*$",
      "color": "#ff0000",
      "comment": "aaa"
    },
    {
      "pattern": "WARN",
      "color": "#ff8800",
      "comment": "bbb"
    },
    {
      "pattern": "INFO",
      "color": "#008800",
      "comment": "ccc"
    }
  ],
  "replace_patterns": [
    {
      "search": ".*Temp=[-+]?\\d+(\\.\\d+)?",
      "replace": "KUIHIRO",
      "match_case": false,
      "use_regex": true
    }
  ]
}