{
  "keywords": [
    {
      "pattern": ".*INFO.*System Boot.*",
      "color": "#9efacc",
      "comment": "システム起動",
      "enabled": true
    },
    {
      "pattern": ".*INFO.*WiFi Connected.*",
      "color": "#ff99cc",
      "comment": "WIFI接続完了",
      "enabled": true
    },
    {
      "pattern": ".*INFO.*System Halting.*",
      "color": "#e0e0e0",
      "comment": "システム終了",
      "enabled": true
    },
    {
      "pattern": ".*ERROR.*",
      "color": "#ff0000",
      "comment": "エラー",
      "enabled": true
    },
    {
      "pattern": ".*WARN.*",
      "color": "#ff99cc",
      "comment": "ワーニング",
      "enabled": true
    },
    {
      "pattern": ".*INFO.*",
      "color": "#e0e0e0",
      "comment": "情報",
      "enabled": true
    }
  ],
  "replace_patterns": [
    {
      "search": ".*Temp=[-+]?\\d+(\\.\\d+)?",
      "replace": "温度",
      "enabled": true
